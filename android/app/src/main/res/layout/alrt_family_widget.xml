<?xml version="1.0" encoding="utf-8"?>
<!-- ALRT Family status home-screen widget.
     Solid red card only for a live family SOS ("the two reds", rule 6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/family_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/alrt_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/family_kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FAMILY"
            android:textColor="#B7B7C0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- ALRT mark so the card is recognisable at a glance. -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/alrt_logo"
            android:scaleType="fitCenter"
            android:contentDescription="ALRT" />
    </LinearLayout>

    <TextView
        android:id="@+id/family_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Everyone's safe"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/family_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#C9C9D2"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
